<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpreadsheetLab.App.MainPage"
             Title="Електронні таблиці">

    <!-- Buttons / formula bar / table / status -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Padding="12">

        <!-- 1. Buttons -->
        <ScrollView Grid.Row="0" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="6">
                <Button Text="Нова" Clicked="OnNewClicked" />
                <Button Text="Відкрити" Clicked="OnOpenClicked" />
                <Button Text="Зберегти" Clicked="OnSaveClicked" />
                <Button Text="Зберегти як…" Clicked="OnSaveAsClicked" />
                <Button Text="+ Рядок" Clicked="OnAddRowClicked" />
                <Button Text="− Рядок" Clicked="OnDeleteRowClicked" />
                <Button Text="+ Стовпець" Clicked="OnAddColumnClicked" />
                <Button Text="− Стовпець" Clicked="OnDeleteColumnClicked" />
                <Button x:Name="ModeButton" Text="Режим: ВИРАЗ" Clicked="OnToggleModeClicked" />
                <Button Text="Довідка" Clicked="OnHelpClicked" />
                <Button Text="Про програму" Clicked="OnAboutClicked" />
                <Button Text="Вихід" Clicked="OnExitClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 2. Formula bar -->
        <Grid Grid.Row="1" ColumnDefinitions="60,*,Auto" ColumnSpacing="8">
            <Label x:Name="SelectedCellLabel"
                   Text="A1"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Entry x:Name="FormulaEntry"
                   Grid.Column="1"
                   Placeholder="Вираз, наприклад: =mmax(A1, 5) &gt;= 10"
                   Completed="OnApplyClicked" />
            <Button Grid.Column="2" Text="Застосувати" Clicked="OnApplyClicked" />
        </Grid>

        <!-- 3. Table (cells are added in BuildGrid) -->
        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="TableGrid"
                  RowSpacing="1"
                  ColumnSpacing="1"
                  BackgroundColor="LightGray"
                  HorizontalOptions="Start"
                  VerticalOptions="Start" />
        </ScrollView>

        <!-- 4. Status bar -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <Label x:Name="CellInfoLabel" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Label x:Name="FileInfoLabel" Grid.Column="1" VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>